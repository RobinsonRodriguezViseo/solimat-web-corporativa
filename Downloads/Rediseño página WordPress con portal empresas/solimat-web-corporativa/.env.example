# Copia este archivo a `.env` y rellena los valores.
# `.env` está en .gitignore y NO debe subirse al repositorio.
#
# NO pongas valores reales en ESTE archivo: .env.example SÍ se versiona.
#
# AVISO: Vite incrusta todas las variables `VITE_*` en el bundle de cliente.
# Al ser esta una web pública, estas claves quedan visibles para cualquiera que
# inspeccione el JavaScript. Se replica aquí el mismo patrón que el Portal de
# Pacientes por decisión de proyecto; los datos servidos (provincias y centros)
# son información pública. No añadas aquí ninguna variable con datos sensibles.

# Function App de maestros — provincias
VITE_REACT_APP_MAESTROS_PATH=
VITE_REACT_APP_MAESTROS_KEY=

# Function App de red de centros — centros por provincia y detalle de centro
VITE_REACT_APP_RED_CENTROS_PATH=
VITE_REACT_APP_RED_CENTROS_KEY=

# Google Maps Embed API — mapas de la Red de Centros.
# Restríngela por referente HTTP en Google Cloud Console: viaja en el bundle
# público y su uso es facturable.
VITE_REACT_APP_GOOGLE_MAPS_API_KEY=
